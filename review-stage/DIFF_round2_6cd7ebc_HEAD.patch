new file mode 100644
index 0000000..4791612
--- /dev/null
+++ b/bench/analysis/trim_posthoc.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""
+Silhouette trim applied after the fact to a run's delivered programs.
+
+  python bench/analysis/trim_posthoc.py bench/runs/dev6_v3 bench/cadbench/fresh --jobs 16 \
+      --out bench/runs/dev6_v3_trim.json
+
+The trim is the last stage of exec-verify (exec_verify.verify(trim=True)), after
+the search, so running it on the program a run delivered gives exactly what that
+run would have delivered with the trim on: the delivered program and its
+silhouette-trimmed copy are both executed and judged, and the better valid one is
+kept. Per part: the delivered program's executed record, the trim's, and the
+choice, in the format of exec_verify.
+"""
+import argparse
+import glob
+import json
+import os
+import sys
+from concurrent.futures import ProcessPoolExecutor
+
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+sys.path.insert(0, ROOT)
+RECON = ('best_greedy_parallel_iterative.py', 'best_greedy_parallel.py')
+
+
+def one(job):
+    run, part, target = job
+    import exec_verify
+    prog = next((os.path.join(run, part, r) for r in RECON if os.path.exists(os.path.join(run, part, r))), None)
+    if prog is None:
+        return part, {'status': 'no_program'}
+    out = os.path.join(run, part, 'trim_posthoc')
+    try:
+        # Absolute paths: exec_verify runs each program from its own folder.
+        rec = exec_verify.verify(os.path.abspath(prog), os.path.abspath(target), os.path.abspath(out), trim=True)
+    except Exception as e:  # noqa: BLE001
+        return part, {'status': f'error: {type(e).__name__}: {e}'}
+    v = rec['variants']
+    trim = next((k for k in v if k.endswith('_trim')), None)
+    # The same choice without the trimmed variant: the difference is the trim alone.
+    base = {k: r for k, r in v.items() if k != trim and 'same_program_as' not in r}
+    k0 = exec_verify.choose(base)
+    gated0 = base[k0]['iou_exec'] if k0 and base[k0].get('valid') else 0.0
+    return part, {'status': 'ok', 'chosen': rec['chosen'], 'chosen_valid': rec['chosen_valid'],
+                  'gated': rec['validity_gated_iou'], 'gated_no_trim': gated0, 'trim': trim,
+                  'trim_record': v.get(trim), 'original': v.get('original')}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('run')
+    ap.add_argument('stl_dir')
+    ap.add_argument('--jobs', type=int, default=8)
+    ap.add_argument('--out', required=True)
+    a = ap.parse_args()
+    parts = sorted(os.path.basename(p)[:-4] for p in glob.glob(os.path.join(a.stl_dir, '*.stl')))
+    jobs = [(a.run, p, os.path.join(a.stl_dir, p + '.stl')) for p in parts]
+    res = {}
+    with ProcessPoolExecutor(a.jobs) as ex:
+        for part, r in ex.map(one, jobs):
+            res[part] = r
+            t = r.get('trim_record') or {}
+            print(part[:8], r['status'], r.get('chosen'), round(r.get('gated', 0), 4),
+                  'trim', t.get('valid'), round(t.get('iou_exec', 0) or 0, 4), flush=True)
+    json.dump(res, open(a.out, 'w'), indent=1)
+    ok = [r for r in res.values() if r['status'] == 'ok']
+    print('trim chosen on', sum(bool(r['chosen'] and r['chosen'].endswith('_trim')) for r in ok), 'of', len(ok))
+    n = len(parts)
+    print(f"mean gated over {n} parts: no trim {sum(r.get('gated_no_trim', 0) for r in res.values()) / n:.4f}, "
+          f"with trim {sum(r.get('gated', 0) for r in res.values()) / n:.4f}")
+
+
+if __name__ == '__main__':
+    main()
diff --git a/bench/analysis/v2_dev.py b/bench/analysis/v2_dev.py
new file mode 100644
index 0000000..928acf3
--- /dev/null
+++ b/bench/analysis/v2_dev.py
@@ -0,0 +1,118 @@
+#!/usr/bin/env python3
+"""
+Dev-cohort analysis of the CADFit++ v2 arms (60 parts, bench/cadbench/fresh).
+
+  python3 bench/analysis/v2_dev.py results/dev345_scores.json [results/dev6_scores.json ...] \
+      --pairs dev5_dx:dev5_d0 dev5_v2:dev5_d0 dev5_v2:dev5_dx dev6_v3:dev6_v2 --out results/v2_dev.json
+
+Every cohort part counts: a part a run did not score (no model, never ran) is 0.
+Primary metric: validity-gated CAD IoU (iou_cad_gated). For each run: mean over
+all parts, the benchA / benchE split means and their balanced average, valid
+deliveries. For each pair a-b: mean paired difference with a split-stratified
+paired bootstrap CI (parts resampled within their split, 10,000 resamples,
+seed 0), wins/losses (|d| > 0.005), a two-sided sign test, Holm-adjusted over
+the pairs given, and the share of the difference from parts b did not deliver
+valid CAD.
+"""
+import argparse
+import json
+import math
+import os
+import random
+
+ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+
+def cohort():
+    man = json.load(open(os.path.join(ROOT, 'bench', 'cadbench', 'fresh', 'manifest.json')))
+    return {m['file_id']: m['split'] for m in man}
+
+
+def gated(rec):
+    return float((rec or {}).get('iou_cad_gated') or 0.0)
+
+
+def valid(rec):
+    return bool((rec or {}).get('cad_valid'))
+
+
+def sign_p(w, l):
+    n = w + l
+    if n == 0:
+        return 1.0
+    k = min(w, l)
+    return min(1.0, 2 * sum(math.comb(n, i) for i in range(k + 1)) / 2 ** n)
+
+
+def boot(d, split, n=10000, seed=0, alpha=0.05):
+    groups = {}
+    for p, x in d.items():
+        groups.setdefault(split[p], []).append(x)
+    r = random.Random(seed)
+    stats = []
+    for _ in range(n):
+        tot = cnt = 0
+        for g in groups.values():
+            s = [g[r.randrange(len(g))] for _ in g]
+            tot += sum(s)
+            cnt += len(s)
+        stats.append(tot / cnt)
+    stats.sort()
+    return stats[int(alpha / 2 * n)], stats[int((1 - alpha / 2) * n) - 1]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('scores', nargs='+')
+    ap.add_argument('--pairs', nargs='*', default=[])
+    ap.add_argument('--out')
+    a = ap.parse_args()
+    split = cohort()
+    parts = sorted(split)
+    runs = {}
+    for f in a.scores:
+        runs.update(json.load(open(f)))
+    out = {'n_parts': len(parts), 'runs': {}, 'pairs': {}}
+    for name, res in runs.items():
+        v = {p: gated(res.get(p)) for p in parts}
+        by = {s: [v[p] for p in parts if split[p] == s] for s in ('benchA', 'benchE')}
+        missing = [p for p in parts if res.get(p) is None or res[p].get('status') in ('no_model', 'not_run')]
+        out['runs'][name] = {
+            'mean_gated': sum(v.values()) / len(parts),
+            'benchA': sum(by['benchA']) / len(by['benchA']), 'benchE': sum(by['benchE']) / len(by['benchE']),
+            'balanced': (sum(by['benchA']) / len(by['benchA']) + sum(by['benchE']) / len(by['benchE'])) / 2,
+            'valid': sum(valid(res.get(p)) for p in parts), 'missing': missing}
+    raw = []
+    for pr in a.pairs:
+        x, y = pr.split(':')
+        d = {p: gated(runs[x].get(p)) - gated(runs[y].get(p)) for p in parts}
+        lo, hi = boot(d, split)
+        w = sum(v > 0.005 for v in d.values())
+        l = sum(v < -0.005 for v in d.values())
+        tot = sum(d.values())
+        from_invalid = sum(d[p] for p in parts if not valid(runs[y].get(p)))
+        rec = {'diff': tot / len(parts), 'ci95': [lo, hi], 'wins': w, 'losses': l, 'sign_p': sign_p(w, l),
+               'share_from_b_invalid': from_invalid / tot if tot else None,
+               'both_valid_diff': (lambda q: sum(d[p] for p in q) / len(q) if q else None)(
+                   [p for p in parts if valid(runs[x].get(p)) and valid(runs[y].get(p))])}
+        out['pairs'][pr] = rec
+        raw.append((pr, rec['sign_p']))
+    # Holm over the pairs given (the prespecified family).
+    m = len(raw)
+    running = 0.0
+    for i, (pr, p) in enumerate(sorted(raw, key=lambda t: t[1])):
+        running = max(running, min(1.0, (m - i) * p))
+        out['pairs'][pr]['sign_p_holm'] = running
+    for name, r in out['runs'].items():
+        print(f"{name:<12} gated {r['mean_gated']:.4f}  A {r['benchA']:.4f}  E {r['benchE']:.4f}  "
+              f"valid {r['valid']}/{len(parts)}  missing {len(r['missing'])}")
+    for pr, r in out['pairs'].items():
+        print(f"{pr:<22} {r['diff']:+.4f} [{r['ci95'][0]:+.4f}, {r['ci95'][1]:+.4f}]  {r['wins']}/{r['losses']}  "
+              f"p_holm {r['sign_p_holm']:.4f}  from-invalid {r['share_from_b_invalid']}  "
+              f"both-valid {r['both_valid_diff']}")
+    if a.out:
+        json.dump(out, open(a.out, 'w'), indent=1)
+
+
+if __name__ == '__main__':
+    main()
