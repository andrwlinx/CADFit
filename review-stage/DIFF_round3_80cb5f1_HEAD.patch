index 0000000..631db90
--- /dev/null
+++ b/bench/h2_submit.sh
@@ -0,0 +1,46 @@
+#!/bin/bash
+# Held-out pipeline evaluation (review-stage/HELDOUT_PROTOCOL.md): fresh2, 300 parts.
+#
+#   ssh orcd 'cd /orcd/pool/007/a_lin/cadfit && COMMIT=<sha> bash bench/h2_submit.sh'
+#
+# Freezes every arm's full source before submitting (d0 from e260397 + the
+# infrastructure-only patch; dx/v2/v3 from COMMIT), then submits:
+#   h2s0: d0 dx v2 v3 with SEED 0;  h2s1, h2s2: v2 v3 with SEED 1, 2.
+# 12 chunks of 25 parts per run, JOBS=3; scoring, trim, section control and
+# surface agreement are submitted after the runs finish (bench/runs/*.sh helpers).
+set -eu
+COMMIT=${COMMIT:?set COMMIT to the evaluated commit}
+STLS=${STLS:-bench/cadbench/fresh2}
+D0=${D0:-e260397}
+D0_PATCH=bench/d0_infra.patch
+NCHUNK=12
+EXCL="node[1700-1705,1708-1709,1800-1805]"  # preemptable nodes without /orcd/software
+git diff --quiet HEAD -- . ':!bench/runs' || { echo "uncommitted changes"; exit 1; }
+[ "$(git rev-parse HEAD)" = "$(git rev-parse "$COMMIT")" ] || { echo "checkout is not at COMMIT"; exit 1; }
+mkdir -p bench/runs/arms_logs
+
+freeze() {  # <commit> <dir>: full tree of <commit>, made once
+  [ -f "$2/run_pipeline.py" ] && { echo "frozen: $2 ($(head -1 "$2/SOURCE.txt"))"; return; }
+  mkdir -p "$2"
+  git archive "$1" | tar -x -C "$2"
+  rm -rf "$2/bench/runs" "$2/bench/cadbench"
+  ln -s "$PWD/bench/runs" "$2/bench/runs"
+  ln -s "$PWD/bench/cadbench" "$2/bench/cadbench"
+  echo "git archive $(git rev-parse "$1")" > "$2/SOURCE.txt"
+  echo "froze $1 -> $2"
+}
+
+freeze "$D0" bench/runs/h2s0_d0_code
+grep -q infra bench/runs/h2s0_d0_code/SOURCE.txt || {
+  git apply --directory=bench/runs/h2s0_d0_code "$D0_PATCH"
+  echo "+ $D0_PATCH (infrastructure only: decimation memory, worker retry)" >> bench/runs/h2s0_d0_code/SOURCE.txt
+}
+freeze "$COMMIT" bench/runs/h2s0_dx_code
+for s in 0 1 2; do for a in v2 v3; do freeze "$COMMIT" bench/runs/h2s${s}_${a}_code; done; done
+freeze "$COMMIT" bench/runs/h2_src  # scoring / trim / section control / surface agreement
+
+echo "cohort $STLS: $(ls $STLS/*.stl | wc -l) parts"
+A="-p mit_normal,mit_preemptable --requeue --exclude=$EXCL -t 12:00:00 --array=0-$((NCHUNK - 1))"
+SEED=0 JOBS=3 sbatch -J h2s0 $A bench/arms_job.sh $STLS h2s0 $NCHUNK "d0 dx v2 v3"
+for s in 1 2; do SEED=$s JOBS=3 sbatch -J h2s$s $A bench/arms_job.sh $STLS h2s$s $NCHUNK "v2 v3"; done
+squeue -u $USER
diff --git a/bench/rejudge.py b/bench/rejudge.py
new file mode 100644
index 0000000..0060cdb
--- /dev/null
+++ b/bench/rejudge.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""
+Independent higher-precision re-judge of score.py --cad results.
+
+  python bench/rejudge.py --scores bench/runs/h2_scores.json --stl-dir bench/cadbench/fresh2 \
+      --runs h2s0_v2 h2s0_v3 --jobs 16 --out bench/runs/h2_rejudge.json
+
+Selection decisions stay fixed: the same executed STL (<recon>_cad.stl, written by
+score.py's replay) is judged again. Parts the scores file judged exactly are copied
+(the exact boolean has no sampling error); parts judged by the winding-number Monte
+Carlo estimate are re-judged with an independent seed (1) and 4x the union samples
+(min_union 40,000, up to 20 batches). Validity gating is unchanged.
+"""
+import argparse
+import glob
+import json
+import os
+import sys
+from concurrent.futures import ProcessPoolExecutor
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.dirname(HERE))
+RECON = ('best_greedy_parallel_iterative', 'best_greedy_parallel')
+
+
+def one(job):
+    run, part, gt, rec = job
+    import score
+    out = {'iou_cad_gated': rec.get('iou_cad_gated', 0.0), 'cad_valid': rec.get('cad_valid'),
+           'method': (rec.get('cad_judge') or {}).get('method')}
+    if not rec.get('cad_valid') or out['method'] == 'exact':
+        return run, part, out
+    stem = next((os.path.join(run, part, r) for r in RECON if os.path.exists(os.path.join(run, part, r + '.stl'))),
+                None)
+    stl = stem + '_cad.stl' if stem else None
+    if not stl or not os.path.exists(stl):
+        return run, part, {**out, 'error': 'executed STL missing'}
+    j = score.robust_iou(gt, stl, seed=1, min_union=40000, max_batches=20)
+    return run, part, {**out, 'iou_cad_gated': float(j['iou']), 'first_estimate': rec.get('iou_cad_gated'),
+                       'rejudged': True, 'se': j.get('se'), 'union_samples': j.get('union_samples')}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--scores', required=True)
+    ap.add_argument('--stl-dir', required=True)
+    ap.add_argument('--runs', nargs='+', required=True)
+    ap.add_argument('--jobs', type=int, default=8)
+    ap.add_argument('--out', required=True)
+    a = ap.parse_args()
+    scores = json.load(open(a.scores))
+    root = os.path.join(os.path.dirname(HERE), 'bench', 'runs')
+    jobs = [(os.path.join(root, r), p, os.path.join(a.stl_dir, p + '.stl'), scores[r][p] or {})
+            for r in a.runs for p in sorted(scores[r])]
+    out = {r: {} for r in a.runs}
+    with ProcessPoolExecutor(a.jobs) as ex:
+        for run, part, rec in ex.map(one, jobs):
+            out[os.path.basename(run)][part] = rec
+    json.dump(out, open(a.out, 'w'), indent=1)
